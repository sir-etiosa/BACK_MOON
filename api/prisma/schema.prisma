generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OtpPurpose {
  LOGIN
}

enum DepositStatus {
  PENDING
  CONFIRMED
  CREDITED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  SENT
  CONFIRMED
  REJECTED
}

enum TradeStatus {
  PENDING
  COMPLETED
  FAILED
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

enum LedgerRefType {
  DEPOSIT
  WITHDRAWAL
  TRADE
  ADJUSTMENT
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  emailVerifiedAt DateTime?
  status          String    @default("active")
  createdAt       DateTime  @default(now())

  sessions        Session[]
  otps            AuthOtp[]
  addresses       UserAddress[]
  moneroAddresses MoneroSubaddress[]
  balances        Balance[]
  ledgerEntries   LedgerEntry[]
  deposits        Deposit[]
  withdrawals     Withdrawal[]
  tradesAsA       Trade[]   @relation("TradeUserA")
  tradesAsB       Trade[]   @relation("TradeUserB")

  @@map("users")
}

model AuthOtp {
  id         String      @id @default(uuid())
  userId     String      @map("user_id")
  user       User        @relation(fields: [userId], references: [id])
  codeHash   String      @map("code_hash")
  purpose    OtpPurpose  @default(LOGIN)
  expiresAt  DateTime    @map("expires_at")
  attempts   Int         @default(0)
  consumedAt DateTime?   @map("consumed_at")
  createdAt  DateTime    @default(now()) @map("created_at")

  @@index([userId, purpose])
  @@map("auth_otps")
}

model Session {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  user             User      @relation(fields: [userId], references: [id])
  refreshTokenHash String    @unique @map("refresh_token_hash")
  deviceInfo       String?   @map("device_info")
  createdAt        DateTime  @default(now()) @map("created_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")

  @@index([userId])
  @@map("sessions")
}

model ChainConfig {
  id        String   @id @default(uuid())
  chain     String   @unique // "evm" | "solana" | "tron" | "monero" | "litecoin" | "bitcoin"
  coinType  Int?     @map("coin_type")
  xpub      String? // null for solana (pool-based) and monero (subaddress-based)
  nextIndex Int      @default(0) @map("next_index")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("chain_configs")
}

model UserAddress {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  user            User     @relation(fields: [userId], references: [id])
  chain           String
  derivationIndex Int      @map("derivation_index")
  address         String
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([chain, derivationIndex])
  @@unique([userId, chain])
  @@map("user_addresses")
}

model MoneroSubaddress {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  user            User     @relation(fields: [userId], references: [id])
  accountIndex    Int      @map("account_index")
  subaddressIndex Int      @map("subaddress_index")
  address         String
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([accountIndex, subaddressIndex])
  @@unique([userId])
  @@map("monero_subaddresses")
}

model AddressPool {
  id             String    @id @default(uuid())
  chain          String
  address        String    @unique
  assignedUserId String?   @map("assigned_user_id")
  assignedAt     DateTime? @map("assigned_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([chain, assignedUserId])
  @@map("address_pool")
}

model Asset {
  id              String   @id @default(uuid())
  symbol          String
  chain           String
  decimals        Int
  contractAddress String?  @map("contract_address")
  isActive        Boolean  @default(true) @map("is_active")

  balances      Balance[]
  ledgerEntries LedgerEntry[]
  deposits      Deposit[]
  withdrawals   Withdrawal[]

  @@unique([symbol, chain])
  @@map("assets")
}

model Balance {
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  assetId   String   @map("asset_id")
  asset     Asset    @relation(fields: [assetId], references: [id])
  balance   Decimal  @default(0) @db.Decimal(38, 0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([userId, assetId])
  @@map("balances")
}

model LedgerEntry {
  id           String          @id @default(uuid())
  userId       String          @map("user_id")
  user         User            @relation(fields: [userId], references: [id])
  assetId      String          @map("asset_id")
  asset        Asset           @relation(fields: [assetId], references: [id])
  direction    LedgerDirection
  amount       Decimal         @db.Decimal(38, 0)
  refType      LedgerRefType   @map("ref_type")
  refId        String          @map("ref_id")
  balanceAfter Decimal         @map("balance_after") @db.Decimal(38, 0)
  createdAt    DateTime        @default(now()) @map("created_at")

  @@index([userId, assetId])
  @@index([refType, refId])
  @@unique([refType, refId, userId, direction], name: "ledger_dedupe")
  @@map("ledger_entries")
}

model Deposit {
  id            String        @id @default(uuid())
  userId        String        @map("user_id")
  user          User          @relation(fields: [userId], references: [id])
  assetId       String        @map("asset_id")
  asset         Asset         @relation(fields: [assetId], references: [id])
  address       String
  txHash        String        @map("tx_hash")
  amount        Decimal       @db.Decimal(38, 0)
  confirmations Int           @default(0)
  status        DepositStatus @default(PENDING)
  detectedAt    DateTime      @default(now()) @map("detected_at")
  creditedAt    DateTime?     @map("credited_at")

  @@unique([txHash, address])
  @@map("deposits")
}

model Withdrawal {
  id               String            @id @default(uuid())
  userId           String            @map("user_id")
  user             User              @relation(fields: [userId], references: [id])
  assetId          String            @map("asset_id")
  asset            Asset             @relation(fields: [assetId], references: [id])
  toAddress        String            @map("to_address")
  amount           Decimal           @db.Decimal(38, 0)
  status           WithdrawalStatus  @default(PENDING)
  txHash           String?           @map("tx_hash")
  processedByAdmin String?           @map("processed_by_admin_id")
  processedAt      DateTime?         @map("processed_at")
  notes            String?
  requestedAt      DateTime          @default(now()) @map("requested_at")

  @@index([status])
  @@map("withdrawals")
}

model Trade {
  id             String      @id @default(uuid())
  userAId        String      @map("user_a_id")
  userA          User        @relation("TradeUserA", fields: [userAId], references: [id])
  userBId        String      @map("user_b_id")
  userB          User        @relation("TradeUserB", fields: [userBId], references: [id])
  assetGivenId   String      @map("asset_given_id")
  amountGiven    Decimal     @map("amount_given") @db.Decimal(38, 0)
  assetReceivedId String     @map("asset_received_id")
  amountReceived Decimal     @map("amount_received") @db.Decimal(38, 0)
  status         TradeStatus @default(PENDING)
  createdAt      DateTime    @default(now()) @map("created_at")

  @@map("trades")
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("operator")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admin_users")
}
