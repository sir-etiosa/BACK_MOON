{
  "name": "moon-xch-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "tsx src/scripts/seed.ts",
    "load-xpubs": "tsx src/scripts/load-xpubs.ts",
    "verify-derivation": "tsx src/scripts/verify-address-derivation.ts",
    "create-admin": "tsx src/scripts/create-admin.ts",
    "dev-credit": "tsx src/scripts/dev-credit.ts",
    "derive-xpubs": "tsx src/scripts/offline-derive-xpubs.ts",
    "bundle-phone-script": "esbuild src/scripts/phone/derive-xpubs-source.ts --bundle --platform=neutral --outfile=src/scripts/phone/derive-xpubs-bundle.js",
    "import-pool": "tsx src/scripts/import-address-pool.ts",
    "test:ledger": "tsx src/scripts/ledger-invariant-test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/swagger": "^9.9.2",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@prisma/client": "^5.20.0",
    "@scure/bip32": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "bcryptjs": "^2.4.3",
    "bitcoinjs-lib": "^7.0.4",
    "bs58check": "^4.0.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.5",
    "esbuild": "^0.28.2",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
