DATABASE_URL="postgresql://moonxch:moonxch_dev_password@localhost:5432/moonxch?schema=public"

# Signing secret for access JWTs. Generate with: openssl rand -hex 32
APP_JWT_SECRET="replace_me_with_a_long_random_value"

PORT=4000

# Dev mail transport just logs OTPs to the console. Swap for Resend/Postmark/etc in production.
MAIL_TRANSPORT="console"

# --- Chain xpubs (public key material only — never a seed/private key) ---
# Filled in once the offline derivation script has been run per the seed runbook.
EVM_XPUB=""
TRON_XPUB=""
LTC_XPUB=""
BTC_XPUB=""

# Monero watcher (view-only monero-wallet-rpc instance, cannot spend)
MONERO_WALLET_RPC_URL="http://127.0.0.1:18082/json_rpc"

# --- Chain watcher (deposit detection) config ---
# Free API key from etherscan.io/apidashboard — required for the EVM watcher.
ETHERSCAN_API_KEY=""
# Optional — raises Blockcypher's free-tier rate limit for BTC/LTC watchers.
BLOCKCYPHER_TOKEN=""
# Shared secret the cron-trigger (GitHub Actions) must send to call /cron/* endpoints.
# Generate with: openssl rand -hex 32
CRON_SECRET="replace_me_with_a_long_random_value"
